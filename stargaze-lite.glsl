// Single pass, one terminal sample. Cell-hashed stars, one value-noise band, no feedback buffers.
// AURORA_INTENSITY keeps compatibility with the existing preset switcher.
const float AURORA_INTENSITY = 1.0;
const float TEXT_PROTECT = 1.0;
// Radians per second the sky turns around a pole above the window. Slow enough to notice
// only when you look back after a while.
const float SKY_DRIFT = 0.0006;
const float MILKY_WAY = 0.0;
const float SHOOTING_CHANCE = 0.0;
const int FIREFLIES = 0;
const float HEARTH = 0.0;
// Faint indigo depth toward the top. Zero keeps empty sky at true black for OLED screens.
const float SKY_TINT = 0.0;

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

vec4 hash42(vec2 p) {
    vec4 p4 = fract(vec4(p.xyxy) * vec4(0.1031, 0.1030, 0.0973, 0.1099));
    p4 += dot(p4, p4.wzxy + 33.33);
    return fract((p4.xxyz + p4.yzzw) * p4.zywx);
}

float valueNoise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash12(i);
    float b = hash12(i + vec2(1.0, 0.0));
    float c = hash12(i + vec2(0.0, 1.0));
    float d = hash12(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

vec2 rotateAround(vec2 p, vec2 pole, float angle) {
    float c = cos(angle);
    float s = sin(angle);
    vec2 d = p - pole;
    return pole + vec2(c * d.x - s * d.y, s * d.x + c * d.y);
}

// One layer of stars: at most one per cell, kept away from cell edges so a single cell
// lookup never clips a star. Most are faint; a few are bright, and the brightest glint.
vec3 starLayer(vec2 p, float cells, float density, float seed, float time, float size, float glint) {
    vec2 grid = p * cells;
    vec2 cell = floor(grid);
    vec4 h = hash42(cell + seed);
    if (h.w > density) {
        return vec3(0.0);
    }
    vec2 offset = grid - (cell + 0.25 + 0.5 * h.xy);
    float d = length(offset);
    float pixel = cells / max(iResolution.y, 1.0);
    float magnitude = 0.18 + 0.82 * h.z * h.z * h.z;
    float core = 1.0 - smoothstep(0.0, pixel * size, d);
    float halo = exp2(-d * d / (pixel * pixel * size * size * 9.0)) * 0.22;
    // Thin cross glints on the brightest stars, like light through a lens.
    float spikes = 0.0;
    if (glint > 0.0 && magnitude > 0.62) {
        vec2 a = abs(offset) / pixel;
        spikes = (exp2(-a.x * 0.32 - a.y * a.y * 1.2) + exp2(-a.y * 0.32 - a.x * a.x * 1.2)) * glint * 0.35;
    }
    // Slow scintillation, never fully off.
    float twinkle = 0.62 + 0.38 * sin(time * (0.35 + 1.1 * h.x) + h.y * 6.2831);
    // Star colours from warm amber through white to pale blue.
    vec3 warm = vec3(1.00, 0.76, 0.52);
    vec3 white = vec3(1.00, 0.96, 0.90);
    vec3 cool = vec3(0.70, 0.80, 1.00);
    float temperature = fract(h.x * 7.13 + h.y * 3.71);
    vec3 tint = temperature < 0.5 ? mix(warm, white, temperature * 2.0) : mix(white, cool, temperature * 2.0 - 1.0);
    return tint * (core + halo + spikes) * magnitude * twinkle;
}

// A soft, dusty band of the galaxy with a darker rift down its middle.
float milkyWay(vec2 p, out float across) {
    vec2 dir = normalize(vec2(1.0, 0.58));
    vec2 nrm = vec2(-dir.y, dir.x);
    across = dot(p - vec2(0.05, 0.08), nrm);
    float along = dot(p, dir);
    float width = 0.15 + 0.05 * sin(along * 2.3 + 1.0);
    float band = exp2(-across * across / (width * width) * 1.6);
    // Outside about 2.5 widths the band is below one 8-bit level, so skip its noise lookups.
    if (abs(across) > width * 2.5) {
        return 0.0;
    }
    float dust = 0.6 * valueNoise(vec2(along * 3.1, across * 7.0)) + 0.4 * valueNoise(vec2(along * 7.3, across * 15.0) + 11.0);
    float rift = smoothstep(0.42, 0.78, valueNoise(vec2(along * 2.4, across * 10.0) + 5.0));
    band *= 0.45 + 0.75 * dust;
    band *= 1.0 - 0.6 * rift * exp2(-across * across / (width * width) * 6.0);
    return band;
}

// A rare meteor: each 19 s slot rolls once for whether one crosses, when, and where.
float shootingStar(vec2 p, float time, float w) {
    if (SHOOTING_CHANCE <= 0.0) {
        return 0.0;
    }
    const float SLOT = 19.0;
    const float DURATION = 1.3;
    float slot = floor(time / SLOT);
    vec4 h = hash42(vec2(slot, 7.31));
    if (h.w > SHOOTING_CHANCE) {
        return 0.0;
    }
    float life = (time - slot * SLOT - h.z * (SLOT - DURATION)) / DURATION;
    if (life < 0.0 || life > 1.0) {
        return 0.0;
    }
    float side = h.y < 0.5 ? -1.0 : 1.0;
    vec2 dir = normalize(vec2(side, -0.42 - 0.25 * h.x));
    vec2 origin = vec2(-side * w * (0.15 + 0.55 * h.x), 0.22 + 0.24 * fract(h.y * 9.7));
    vec2 head = origin + dir * life * 0.62;
    float tail = 0.18 * smoothstep(0.0, 0.35, life);
    vec2 rel = p - head;
    float s = clamp(dot(rel, -dir), 0.0, tail);
    float d = length(rel + dir * s);
    float pixel = 1.0 / max(iResolution.y, 1.0);
    float line = exp2(-d * d / (pixel * pixel * 2.2));
    float fade = 1.0 - s / max(tail, 1e-4);
    return line * fade * fade * sin(life * 3.14159265);
}

vec3 stargazeSky(vec2 uv, float time) {
    float aspect = iResolution.x / max(iResolution.y, 1.0);
    // Ghostty's fragCoord starts at the top-left, so flip y to make the sky point up.
    vec2 p = vec2((uv.x - 0.5) * aspect, 0.5 - uv.y);
    float w = 0.5 * aspect;
    vec2 pole = vec2(-0.35 * w, 1.6);
    float turn = time * SKY_DRIFT;
    vec2 sky = rotateAround(p, pole, turn);

    // Night deepens toward the top: a barely-there indigo so the dark has some depth.
    float height = smoothstep(-0.55, 0.55, p.y);
    vec3 light = vec3(0.020, 0.026, 0.060) * height * SKY_TINT;

    float across = 0.0;
    float band = MILKY_WAY > 0.0 ? milkyWay(sky, across) * MILKY_WAY : 0.0;
    light += mix(vec3(0.30, 0.22, 0.20), vec3(0.24, 0.22, 0.38), smoothstep(-0.12, 0.12, across)) * band * 0.30;

    // Three depths of stars; nearer layers turn a little faster for a hint of parallax.
    float crowd = 1.0 + 1.6 * band;
    vec3 stars = starLayer(sky, 64.0, 0.16 * crowd, 3.0, time, 1.2, 0.0) * 0.55;
    stars += starLayer(rotateAround(p, pole, turn * 1.08), 30.0, 0.16, 41.0, time, 1.6, 0.0) * 0.85;
    stars += starLayer(rotateAround(p, pole, turn * 1.16), 13.0, 0.10, 97.0, time, 1.9, 1.0);
    // Stars thin out toward the warm horizon, as if hidden by haze.
    stars *= smoothstep(-0.52, -0.05, p.y);
    light += stars * 0.62;

    light += vec3(0.95, 0.92, 1.0) * shootingStar(p, time, w) * 0.42;

    // The hearth: a low ember-and-rose glow along the bottom that breathes like a fire.
    float flicker = 0.88 + 0.08 * sin(time * 1.30) + 0.04 * sin(time * 2.71 + 1.3);
    // The glow ends by the lower third, so the sky above it stays true black.
    float rise = exp2(-(p.y + 0.5) * 7.0) * (0.80 + 0.20 * sin(p.x * 2.2 + time * 0.12));
    rise *= 1.0 - smoothstep(-0.36, -0.12, p.y);
    vec3 hearth = mix(vec3(0.72, 0.30, 0.07), vec3(0.50, 0.16, 0.22), smoothstep(-0.48, -0.22, p.y));
    light += hearth * rise * flicker * 0.17 * HEARTH;

    // Fireflies drifting low in the warm air, each pulsing on its own slow beat.
    float pixel = 1.0 / max(iResolution.y, 1.0);
    // Fireflies never rise above y = -0.21 and their glow fades within ~0.1, so the upper
    // sky skips the loop entirely.
    int fireflies = p.y < -0.08 ? FIREFLIES : 0;
    for (int i = 0; i < fireflies; i++) {
        float k = float(i);
        vec4 h = hash42(vec2(k, 3.17));
        vec2 c = vec2((h.x - 0.5) * 1.8 * w + 0.09 * sin(time * (0.11 + 0.06 * h.y) + k * 2.1),
                      -0.40 + 0.14 * h.y + 0.05 * sin(time * (0.17 + 0.08 * h.z) + k));
        float pulse = pow(0.5 + 0.5 * sin(time * (0.38 + 0.3 * h.z) + h.w * 6.2831), 4.0);
        vec2 d = p - c;
        float r2 = dot(d, d);
        float glow = exp2(-r2 / (pixel * pixel * 5.0)) + exp2(-r2 / 0.0011) * 0.22;
        light += vec3(1.0, 0.70, 0.28) * glow * pulse * 0.60;
    }

    // Black floor: the faint tails of halos, the band, and the hearth sit a level or two above
    // black, where they are invisible but would keep OLED pixels lit. Subtract them away.
    const float BLACK_FLOOR = 2.0 / 255.0;
    light = max(light - BLACK_FLOOR, 0.0);

    // Highlight knee: faint sky passes through untouched, while star and firefly cores
    // roll off smoothly toward HIGHLIGHT_LIMIT so no point reads as a stray glyph.
    const float KNEE = 0.20;
    const float HIGHLIGHT_LIMIT = 0.32;
    float brightest = max(light.r, max(light.g, light.b));
    if (brightest > KNEE) {
        float span = HIGHLIGHT_LIMIT - KNEE;
        light *= (KNEE + span * (1.0 - exp(-(brightest - KNEE) / span))) / brightest;
    }
    return light;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    vec2 uv = fragCoord / iResolution.xy;
    vec4 terminal = texture(iChannel0, uv);
    float peak = max(terminal.r, max(terminal.g, terminal.b));
    float luma = dot(terminal.rgb, vec3(0.2126, 0.7152, 0.0722));
    float edge = max(fwidth(peak), fwidth(luma));
    float glyph = smoothstep(0.012, 0.075, edge) * TEXT_PROTECT;
    // Protect saturated ANSI text as well as bright text and light themes.
    float background = 1.0 - smoothstep(0.16, 0.40, peak);
    float mask = background * (1.0 - glyph);
    vec3 light = stargazeSky(uv, iTime) * AURORA_INTENSITY;
    // Sub-LSB dither keeps the long, dark gradients from banding on 8-bit surfaces. It fades
    // out where no light is added, so empty sky stays exactly the terminal colour and true
    // black stays switched off on OLED screens.
    float lit = smoothstep(0.5 / 255.0, 2.0 / 255.0, max(light.r, max(light.g, light.b)));
    float dither = (hash12(fragCoord) - 0.5) / 255.0 * lit;
    fragColor = vec4(terminal.rgb + (light + dither) * mask * terminal.a, terminal.a);
}
