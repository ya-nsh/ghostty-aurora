// Single pass, one terminal sample, analytic light pools. No noise textures or feedback buffers.
// AURORA_INTENSITY keeps compatibility with the existing preset switcher.
const float AURORA_INTENSITY = 0.80;
const float NOCTURNE_SPEED = 0.12;
const float TEXT_PROTECT = 1.0;
const int NOCTURNE_POOLS = 5;
const float STAR_DENSITY = 0.16;
// Seconds into the drift to hold the composition around; negative drifts freely forever.
const float NOCTURNE_ANCHOR = 160.0;
const float NOCTURNE_WANDER = 12.0;

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

vec3 hash32(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yxz + 33.33);
    return fract((p3.xxy + p3.yzz) * p3.zyx);
}

// A soft pool of light. exp2 of a scaled squared distance is a cheap gaussian.
float pool(vec2 p, vec2 center, float radius) {
    vec2 d = p - center;
    return exp2(-dot(d, d) / (radius * radius));
}

// Sparse stars, one jittered candidate per cell, concentrated toward the top of the sky.
float stars(vec2 p, float time) {
    if (STAR_DENSITY <= 0.0) {
        return 0.0;
    }
    const float CELLS = 34.0;
    vec2 grid = p * CELLS;
    vec2 cell = floor(grid);
    vec3 h = hash32(cell + 17.0);
    if (h.z > STAR_DENSITY) {
        return 0.0;
    }
    vec2 star = cell + 0.2 + 0.6 * h.xy;
    float d = length(grid - star);
    float pixel = CELLS / max(iResolution.y, 1.0);
    float core = smoothstep(pixel * 2.2, 0.0, d);
    float halo = exp2(-d * d * 90.0) * 0.35;
    float twinkle = 0.55 + 0.45 * sin(time * (0.7 + 1.6 * h.x) + h.y * 6.2831);
    float height = smoothstep(-0.18, 0.42, p.y);
    return (core + halo) * twinkle * height * (0.45 + 0.55 * h.y);
}

// Anchored variants sway within NOCTURNE_WANDER seconds of one moment instead of
// drifting away from it. sin(x / W) * W peaks at the free-running speed, so motion
// feels the same; one full sway takes 2 * pi * W seconds.
float sceneTime(float time) {
    if (NOCTURNE_ANCHOR < 0.0) {
        return time;
    }
    return NOCTURNE_ANCHOR + NOCTURNE_WANDER * sin(time / NOCTURNE_WANDER);
}

vec3 nocturneSky(vec2 uv, float time) {
    float aspect = iResolution.x / max(iResolution.y, 1.0);
    // Ghostty's fragCoord starts at the top-left, so flip y to make the sky point up.
    vec2 p = vec2((uv.x - 0.5) * aspect, 0.5 - uv.y);
    float t = sceneTime(time) * NOCTURNE_SPEED;
    float w = 0.5 * aspect;

    // Two soft sine warps give the pools an ink-in-water edge without noise octaves.
    vec2 q = p;
    q += 0.11 * vec2(sin(q.y * 2.4 + t * 1.30), sin(q.x * 2.1 - t * 1.10));
    q += 0.05 * vec2(sin(q.y * 5.1 - t * 0.90 + 1.7), sin(q.x * 4.4 + t * 0.80 + 0.6));

    const vec3 indigo = vec3(0.19, 0.25, 0.92);
    const vec3 jade = vec3(0.02, 0.58, 0.50);
    const vec3 plum = vec3(0.66, 0.15, 0.60);
    const vec3 ember = vec3(1.00, 0.44, 0.14);

    vec3 light = vec3(0.0);
    light += indigo * 0.95 * pool(q, vec2(-0.55 * w + 0.22 * w * sin(t * 0.61), 0.20 + 0.10 * cos(t * 0.47)), 0.44);
    light += jade * 0.85 * pool(q, vec2(0.48 * w + 0.20 * w * sin(t * 0.53 + 2.0), 0.08 + 0.14 * sin(t * 0.71 + 1.0)), 0.38);
    // The ember sits just below the frame, so it reads as a horizon glow rising from below.
    vec2 sun = vec2(0.30 * w + 0.28 * w * sin(t * 0.37 + 0.8), -0.62 + 0.04 * sin(t * 0.9));
    float horizon = pool((q - sun) * vec2(0.55, 1.0) + sun, sun, 0.36);
    light += ember * 0.95 * horizon;
    if (NOCTURNE_POOLS > 3) {
        light += plum * 0.80 * pool(q, vec2(-0.05 * w + 0.45 * w * cos(t * 0.43 + 4.0), -0.12 + 0.12 * sin(t * 0.59 + 3.0)), 0.33);
    }
    if (NOCTURNE_POOLS > 4) {
        light += indigo * 0.55 * pool(q, vec2(0.85 * w * sin(t * 0.29 + 5.0), 0.46 + 0.05 * cos(t * 0.33)), 0.34);
    }

    // Soft-clip the brightest channel and scale the others with it, so overlapping
    // pools stay saturated instead of washing out toward grey.
    float peakLight = max(light.r, max(light.g, light.b));
    light *= (1.0 - exp(-peakLight * 1.4)) / max(peakLight, 1e-4);

    // A faint satin sheen traced along the field's contours, like light on slow water.
    float field = dot(light, vec3(0.30, 0.45, 0.25));
    float sheen = pow(0.5 + 0.5 * sin(field * 26.0 - t * 2.4 + q.x * 2.2 - q.y * 1.3), 6.0);
    light *= 1.0 + 0.10 * sheen;

    // Stars dim where the pools are bright, as real stars wash out under sky glow.
    float starlight = stars(p, time) * (1.0 - smoothstep(0.08, 0.40, field));
    light += vec3(0.86, 0.90, 1.0) * starlight;

    // Quiet the outer frame so the eye settles on the middle of the terminal.
    float falloff = 1.0 - 0.38 * smoothstep(0.35, 1.25, length(p * vec2(0.62, 0.95)));
    return light * falloff * 0.30;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    vec2 uv = fragCoord / iResolution.xy;
    vec4 terminal = texture(iChannel0, uv);
    float peak = max(terminal.r, max(terminal.g, terminal.b));
    float luma = dot(terminal.rgb, vec3(0.2126, 0.7152, 0.0722));
    float edge = max(fwidth(peak), fwidth(luma));
    float glyph = smoothstep(0.012, 0.075, edge) * TEXT_PROTECT;
    // Protect saturated ANSI text as well as bright text and light themes.
    float background = 1.0 - smoothstep(0.16, 0.40, peak);
    float mask = background * (1.0 - glyph);
    vec3 light = nocturneSky(uv, iTime) * AURORA_INTENSITY;
    // Sub-LSB dither keeps the long, dark gradients from banding on 8-bit surfaces.
    float dither = (hash12(fragCoord) - 0.5) / 255.0 * step(0.0001, AURORA_INTENSITY);
    fragColor = vec4(terminal.rgb + (light + dither) * mask * terminal.a, terminal.a);
}
